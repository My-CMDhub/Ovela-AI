# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

*.tar.gz
/appwrite-function
*.html
*demo

#virtual env
venv/
.venv
__pycache__/
.next/

# Local scripts (keep health_check.py only)
scripts/*.py
!scripts/health_check.py
# The identity harness: one roster, one case list, replayable by anyone.
!scripts/identity_corpus.py
!scripts/seed_reservations.py
!scripts/eval_identity.py
!scripts/probe_asr_confidence.py
!scripts/replay_conversation.py

# Local documentation
redeploy-guide.md
!scripts/probe_live_call.py
