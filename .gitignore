# Ignore all files/folders in root except backend/, frontend/, and the core files
/*
!/backend/
!/frontend/
!/.gitignore
!/README.md
!/deploy_cloud_run.py
!/docs/
!/images/
!/traces/

# Local working notes. Measurements are published with the write-up, so
# keeping a copy here would create a second source of truth that can drift.
# `gemini_trace_analysis.json` is the exception: it is the analyser's own
# output and is referenced by scripts/analyze_trace.py.
/.hackathon/*
!/.hackathon/gemini_trace_analysis.json
/memory_bank/
/.agents/
/scratch/
/recent_logs.txt
# Ignore contents of docs except methodology and the visual architecture diagram
/docs/*
!/docs/EVALUATION_METHODOLOGY.md
!/docs/Google AI Challenge/
/docs/Google AI Challenge/*
!/docs/ovela_architecture_diagram.png

# Ignore Next.js / Node / python cache files inside backend and frontend
**/node_modules/
**/.next/
**/__pycache__/
**/*.pyc
**/.pytest_cache/
**/*.pem
**/*.tar.gz
**/*.DS_Store
**/venv/
**/.venv/
**/logs/

backend/tests/**
!backend/tests/run_multi_agent_evaluation.py
!backend/tests/evaluation_run.json
!backend/tests/asr_noise_simulator.py
!backend/tests/test_vad.py
!backend/tests/test_interruption_trim.py
!backend/tests/test_deepgram_standalone.py
!backend/tests/test_cartesia_standalone.py
!backend/tests/test_cascaded_orchestrator.py
backend/scripts/test_email_zoho.py
backend/redeploy-guide.md
# backend/Procfile
backend/stream

**/*.md
!/README.md
!/traces/README.md
!/docs/EVALUATION_METHODOLOGY.md
!backend/requirements.txt

# Local-only agent config — never pushed
/CLAUDE.md
/CLAUDE.local.md
/.claude/
**/.claude/
!backend/tests/test_tenant_config_lookup.py
!backend/tests/test_latency_watchdog.py
!backend/tests/test_reservation_cache.py
