# Ignore all files/folders in root except backend/, frontend/, and the core files
/*
!/backend/
!/frontend/
!/.gitignore
!/README.md
!/deploy_cloud_run.py
!/docs/
!/images/

# Ignore contents of docs except methodology and the visual architecture diagram
/docs/*
!/docs/EVALUATION_METHODOLOGY.md
!/docs/Google AI Challenge/
/docs/Google AI Challenge/*
!/docs/ovela_architecture_diagram.png

# Ignore Next.js / Node / python cache files inside backend and frontend
**/node_modules/
**/.next/
**/__pycache__/
**/*.pyc
**/.pytest_cache/
**/*.pem
**/*.tar.gz
**/*.DS_Store
**/venv/
**/.venv/
**/logs/

backend/tests/**
!backend/tests/run_multi_agent_evaluation.py
!backend/tests/evaluation_run.json
!backend/tests/asr_noise_simulator.py
backend/scripts/test_email_zoho.py
backend/redeploy-guide.md
backend/Procfile
backend/stream

**/*.md
!/README.md
!/docs/EVALUATION_METHODOLOGY.md